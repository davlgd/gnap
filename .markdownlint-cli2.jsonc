// markdownlint-cli2 options: which files to lint. The rules are in .markdownlint.jsonc.
{
  // Skip what .gitignore excludes, such as build output and local notes
  "gitignore": true,
  // Vendored RFC sources keep their upstream text
  // conformance/REPORT.md is generated by tools/conformance_ledger.py, whose
  // digest the evidence receipts record: fix it in the generator when the
  // receipts are next replayed, not by hand
  "ignores": ["conformance/sources/**", "conformance/REPORT.md", "target/**", "**/target/**"]
}
