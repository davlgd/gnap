// markdownlint rules for the repository's Markdown. Rules not listed here keep
// their defaults: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
{
  // Unordered lists use "-" markers
  "MD004": { "style": "dash" },
  // A paragraph stays on one line and the editor wraps it, so no line length
  "MD013": false,
  // Inline HTML is forbidden, except line breaks in table cells
  "MD033": { "allowed_elements": ["br"] },
  // Italics use *text*, like bold uses **text**
  "MD049": { "style": "asterisk" },
  "MD050": { "style": "asterisk" },
  // Table rows start and end with a pipe
  "MD055": { "style": "leading_and_trailing" }
}
